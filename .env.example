# Password for /builder, /dashboard and previews. If unset, one is generated into data/admin-password.txt
ADMIN_PASSWORD=
# Optional. Enables AI-assisted candidate mapping (suggestions only, never auto-verified).
# NOTE: setting this sends excerpts of uploaded papers to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. URL of a GROBID service you run, e.g. http://localhost:8070
GROBID_URL=
# Optional. Raises the OpenAlex daily budget. Without it the shared keyless budget applies.
OPENALEX_API_KEY=
# Optional. Bearer token that lets an external cron call POST /api/cron/refresh
CRON_SECRET=
# Set to 0 to disable the in-process refresh scheduler
SCHEDULER=1
# Where SQLite database and uploads are stored
DATA_DIR=./data
